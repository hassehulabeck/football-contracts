# ── Backend URL ───────────────────────────────────────────────────────────────
# Set to the Railway-generated backend URL after the backend service is deployed.
# Example: https://football-contracts-backend.up.railway.app
#
# IMPORTANT: this variable is baked into the Next.js bundle at BUILD time.
# If you change it, you must trigger a new deploy (not just a restart).
NEXT_PUBLIC_API_URL=https://your-backend.up.railway.app
