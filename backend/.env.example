# ── Database ──────────────────────────────────────────────────────────────────
# Railway injects this automatically when you link a Postgres service, so it is
# NOT set in the dashboard by hand.
#
# Locally, point this at a LOCAL Postgres only. Do not paste a production proxy
# URL here: a stale one silently sent a whole phase's worth of writes to an
# orphaned database that carried the same schema and looked entirely healthy.
# Run admin tasks against production on the service instead:
#   railway ssh --service football-coupons-backend "npm run ingest:matches:prod"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/football_contracts

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# ── API-Football ──────────────────────────────────────────────────────────────
FOOTBALL_API_KEY=your-api-football-key

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up at resend.com — free tier covers development volumes.
RESEND_API_KEY=re_your_resend_api_key
# Must be a verified sender domain in your Resend account.
FROM_EMAIL=noreply@yourdomain.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# FRONTEND_URL is the canonical frontend address; activation links point here.
# CORS_ORIGINS (comma-separated) lists every address the frontend is served from.
# Defaults to FRONTEND_URL alone when unset.
FRONTEND_URL=https://www.football-contracts.se
CORS_ORIGINS=https://www.football-contracts.se,https://football-coupons-frontend-production.up.railway.app

# ── Server ────────────────────────────────────────────────────────────────────
# Railway injects PORT automatically — do not set this manually in the dashboard.
# PORT=4000
