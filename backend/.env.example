# ── Database ──────────────────────────────────────────────────────────────────
# Railway injects this automatically when you link a Postgres service.
# Copy it from the Railway Postgres service → Connect → Public URL.
DATABASE_URL=postgresql://user:password@host:port/dbname

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=7d

# ── API-Football ──────────────────────────────────────────────────────────────
FOOTBALL_API_KEY=your-api-football-key

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Sign up at resend.com — free tier covers development volumes.
RESEND_API_KEY=re_your_resend_api_key
# Must be a verified sender domain in your Resend account.
FROM_EMAIL=noreply@yourdomain.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to the Railway-generated frontend URL after the frontend service is deployed.
# Example: https://football-contracts-frontend.up.railway.app
FRONTEND_URL=https://your-frontend.up.railway.app

# ── Server ────────────────────────────────────────────────────────────────────
# Railway injects PORT automatically — do not set this manually in the dashboard.
# PORT=4000
