generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum League {
  ALLSVENSKAN
  DAMALLSVENSKAN
  SUPERETTAN
  ELITETTAN
  CHAMPIONSHIP
}

// Every ordered combination of three results. The first five were the original
// fixed set; the rest were added 2026-10-08 when patterns became fully random.
enum ContractPattern {
  WWW
  DDD
  LLL
  WDL
  LDW
  WWD
  WWL
  WDW
  WDD
  WLW
  WLD
  WLL
  DWW
  DWD
  DWL
  DDW
  DDL
  DLW
  DLD
  DLL
  LWW
  LWD
  LWL
  LDD
  LDL
  LLW
  LLD
}

// PENDING  → contract exists, auction not yet started
// ACTIVE   → auction is open (within 48h window)
// CLOSED   → auction ended, coupons distributed to winners
// FULFILLED → team completed the pattern, coupon holders paid
// FAILED   → contract window expired without pattern being met
enum ContractStatus {
  PENDING
  ACTIVE
  CLOSED
  FULFILLED
  FAILED
}

// Why a player's balance moved. Profit — what the leaderboard ranks by — is
// COUPON_PURCHASE + COUPON_PAYOUT only: the starting grant, corrections and
// any future refinancing of broke players are credits a player was handed,
// not credits they earned.
enum CreditTransactionType {
  STARTING_BALANCE
  COUPON_PURCHASE
  COUPON_PAYOUT
  ADJUSTMENT
  REFINANCE
}

enum FixtureStatus {
  SCHEDULED
  POSTPONED
  CANCELLED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  emailVerified   Boolean   @default(false)
  activationToken String?   @unique
  // Null until the first activation email goes out. Lets the resend route
  // throttle by elapsed time instead of tracking a separate counter.
  activationTokenSentAt DateTime?
  // SHA-256 of the emailed reset token, never the token itself, so a read of
  // this table cannot be turned into a password reset. Cleared on use.
  passwordResetTokenHash String?   @unique
  passwordResetExpiresAt DateTime?
  // Doubles as the cooldown clock for /forgot-password, like activationTokenSentAt.
  passwordResetSentAt    DateTime?
  credits         Int       @default(1000)
  // Grants /api/admin. Only settable from the server (npm run admin:grant),
  // never through the API, and re-read from the database on every admin
  // request rather than trusted from the JWT, so a revoke bites immediately.
  isAdmin         Boolean   @default(false)
  // The public identity, shown on the leaderboard in place of the email.
  //
  // Nullable because every account predates the column, and registration does
  // not ask for one — the app forces it to be set on next login instead. Uses
  // are expected to null-guard; the leaderboard falls back to "Anonymous"
  // rather than leaking the email it was added to hide.
  //
  // @unique is case-sensitive: Postgres has no case-insensitive unique index
  // without citext. Case-insensitive collisions are rejected in the route
  // before the write, and this constraint is the backstop for the race.
  username          String?   @unique
  // Null until the first username is set, so a first set is never rate-limited.
  usernameChangedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bids               Bid[]
  coupons            Coupon[]
  creditTransactions CreditTransaction[]
}

model Team {
  id         String   @id @default(cuid())
  externalId Int      @unique // api-football.com team ID
  name       String
  league     League

  contracts Contract[]
  matches   Match[]
  fixtures  Fixture[]
}

model Contract {
  id           String          @id @default(cuid())
  teamId       String
  pattern      ContractPattern
  status       ContractStatus  @default(PENDING)
  couponCount  Int             // snapshotted at creation time
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  // When the contract became FULFILLED or FAILED. Null while it is still live.
  // Not derivable from updatedAt: that moves on any write, so a results feed
  // ordered by it would reshuffle after an unrelated update.
  resolvedAt   DateTime?

  team               Team                @relation(fields: [teamId], references: [id])
  coupons            Coupon[]
  auction            Auction?
  creditTransactions CreditTransaction[]
}

model Coupon {
  id         String   @id @default(cuid())
  contractId String
  ownerId    String?  // null until auction closes and winners are determined
  paidOut    Boolean  @default(false)
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id])
  owner    User?    @relation(fields: [ownerId], references: [id])
}

model Auction {
  id         String   @id @default(cuid())
  contractId String   @unique
  endsAt     DateTime
  closed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id])
  bids     Bid[]
}

model Bid {
  id        String   @id @default(cuid())
  auctionId String
  userId    String
  amount    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auction Auction @relation(fields: [auctionId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  // one bid per user per auction; upsert replaces rather than stacks
  @@unique([auctionId, userId])
}

// Stores individual match results from api-football.com, per tracked team.
// result is W/D/L from that team's perspective (pre-computed on ingest).
//
// One fixture produces TWO rows when both clubs are tracked — one per side.
// externalId alone must NOT be unique: it was, and because both sides of a
// Swedish league match are tracked teams, the second side's upsert overwrote
// the first side's result while leaving teamId pointing at the first team.
// That silently inverted 48 of 390 rows and left 37 of 60 teams with no
// matches at all.
model Match {
  id         String   @id @default(cuid())
  externalId Int // api-football.com fixture ID
  teamId     String
  result     String // "W", "D", or "L"
  homeScore  Int
  awayScore  Int
  isHome     Boolean
  playedAt   DateTime
  createdAt  DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])

  @@unique([externalId, teamId])
  @@index([teamId, playedAt])
}

// Fixtures that have not been played yet, so a contract page can show what is
// coming for the team rather than only what already happened.
//
// Shaped per-side like Match, and unique on (externalId, teamId) for the same
// reason — see the comment above Match. Both clubs in a Swedish league fixture
// are tracked, so one fixture is two rows and each side reads its opponent off
// the sibling row.
//
// Kept in its own table rather than as nullable columns on Match: a Match row
// asserts a result, and every consumer of it (findPatternWindow above all)
// counts on that. A scheduled fixture has no result to assert.
//
// Refreshed weekly. api-football has no push or webhook for reschedules, so a
// row can be stale for up to a week; readers filter on kickoffAt rather than
// trusting the table to be current.
model Fixture {
  id         String        @id @default(cuid())
  externalId Int // api-football.com fixture ID
  teamId     String
  isHome     Boolean
  kickoffAt  DateTime
  status     FixtureStatus @default(SCHEDULED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@unique([externalId, teamId])
  @@index([teamId, kickoffAt])
}

// Per-league knobs for the weekly batch, edited from /admin. One row per
// league, seeded by the migration that created the table. The coupon count for
// a new contract is clamp(round(activated players × couponRatio), couponMin,
// couponMax) — see lib/contractBatch.ts.
model LeagueConfig {
  league           League   @id
  enabled          Boolean  @default(true)
  contractsPerWeek Int
  couponRatio      Float    @default(0.1)
  couponMin        Int      @default(5)
  couponMax        Int      @default(100)
  updatedAt        DateTime @updatedAt
  // The admin who made the last change. A plain id, not a relation: the audit
  // trail should survive the account being deleted.
  updatedById      String?
}

// One row per change to User.credits, written in the same transaction as the
// change itself. The invariant is that a player's rows sum to their credits —
// scripts/checkLedger.ts verifies it. Rows predating the ledger were rebuilt
// by its migration, with one ADJUSTMENT per player for whatever the old data
// could not explain (balances edited by hand during testing).
model CreditTransaction {
  id         String                @id @default(cuid())
  userId     String
  // Signed: negative for a purchase, positive for a payout or grant.
  amount     Int
  type       CreditTransactionType
  // The contract a purchase or payout concerns. Null for grants and corrections.
  contractId String?
  // Free text for ADJUSTMENT rows: why, and which admin made it.
  note       String?
  createdAt  DateTime              @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract Contract? @relation(fields: [contractId], references: [id])

  @@index([userId, createdAt])
  @@index([type, createdAt])
}
