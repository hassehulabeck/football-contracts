{
  "name": "football-contracts-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "sync:teams": "ts-node --transpile-only src/scripts/syncTeams.ts",
    "sync:teams:prod": "node dist/scripts/syncTeams.js",
    "ingest:matches": "ts-node --transpile-only src/scripts/ingestMatches.ts",
    "ingest:matches:prod": "node dist/scripts/ingestMatches.js",
    "ingest:fixtures": "ts-node --transpile-only src/scripts/ingestFixtures.ts",
    "ingest:fixtures:prod": "node dist/scripts/ingestFixtures.js",
    "create:contracts": "ts-node --transpile-only src/scripts/createContracts.ts",
    "create:contracts:prod": "node dist/scripts/createContracts.js"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@prisma/client": "^5.15.0",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "node-cron": "^3.0.3",
    "resend": "^3.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.14.9",
    "@types/node-cron": "^3.0.11",
    "prisma": "^5.15.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
